# Backend Environment Variables (Stage 1 Foundation)
PROJECT_NAME="EduNexus AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Origins (comma-separated string or JSON list)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Supabase Credentials (placeholders for Stage 2+)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"
